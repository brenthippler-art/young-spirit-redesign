# Single-page app fallback for React Router (BrowserRouter).
# Any request that isn't a real file or folder gets served index.html
# instead of a 404, so client-side routing can take over.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files (index.html, assets, etc.) be served normally.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Everything else falls back to index.html.
  RewriteRule . /index.html [L]
</IfModule>

# Cache the hashed build files for a year. Vite gives every build's
# JS, CSS and images a new filename, so returning visitors re-download
# only what changed.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compress text files before sending them.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>